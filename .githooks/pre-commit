#!/bin/sh
#
# Pre-commit guard: refuse to commit secrets or session data.
# Enabled via:  git config core.hooksPath .githooks
#

# 1) Block sensitive paths from ever being staged.
blocked_paths=$(git diff --cached --name-only | grep -E '(^|/)\.env$|(^|/)(conversations|group-history)\.json(\.tmp)?$|(^|/)auth/' || true)
if [ -n "$blocked_paths" ]; then
  echo "pre-commit: refusing to commit secret/session files:"
  echo "$blocked_paths" | sed 's/^/  - /'
  echo "These are git-ignored for a reason. Unstage them and try again."
  exit 1
fi

# 2) Block real values in staged content (generic patterns, no literal secrets here).
#    - a WhatsApp JID containing real digits
#    - a fully-qualified Azure AI Foundry endpoint host (placeholders like <resource> won't match)
if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' \
   | grep -E '[0-9]{6,}@(s\.whatsapp\.net|lid)|[a-z0-9-]+\.services\.ai\.azure\.com/api/projects' >/dev/null; then
  echo "pre-commit: staged changes look like they contain a real WhatsApp number"
  echo "or a real Azure AI Foundry endpoint. Replace with a <placeholder> before committing."
  exit 1
fi

exit 0
