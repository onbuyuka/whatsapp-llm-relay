{
  "name": "whatsapp-llm-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal WhatsApp bot that relays messages to an Azure AI Foundry agent with Grounding with Bing Search.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
