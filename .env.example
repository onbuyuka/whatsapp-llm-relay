# Full agent Responses endpoint URL from Foundry (the agent's OpenAI
# "responses" protocol endpoint), e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses
AGENT_RESPONSES_URL=

# API version for the responses endpoint (v1, or a dated preview like 2025-11-15-preview).
AGENT_API_VERSION=v1

# Comma-separated allowlist of WhatsApp numbers. Digits only, including the
# country code, with no leading + and no spaces. Only these numbers can use the bot,
# including when they mention it in a group chat.
ALLOWLIST_NUMBERS=

# Hours of inactivity after which a new conversation thread is auto-started.
IDLE_RESET_HOURS=8

# Max characters accepted from an incoming message.
MAX_MESSAGE_CHARS=2000

# Number of recent text messages retained per group and supplied as context when
# the bot is mentioned. Group history is stored locally in group-history.json.
GROUP_HISTORY_MESSAGES=50
